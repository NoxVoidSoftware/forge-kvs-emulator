{
  "name": "@noxvoid-software/forge-kvs-emulator",
  "version": "0.1.0",
  "description": "In-memory emulator of the Atlassian Forge KVS and Custom Entity Store for tests. Runs the real @forge/kvs client and enforces your manifest.yml schema.",
  "keywords": [
    "atlassian",
    "forge",
    "kvs",
    "custom-entities",
    "storage",
    "emulator",
    "mock",
    "testing",
    "vitest",
    "jest"
  ],
  "license": "MIT",
  "author": "NoxVoid Software",
  "homepage": "https://github.com/NoxVoidSoftware/forge-kvs-emulator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoxVoidSoftware/forge-kvs-emulator.git"
  },
  "bugs": {
    "url": "https://github.com/NoxVoidSoftware/forge-kvs-emulator/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run coverage && npm run build && npm run smoke && npm run check:package",
    "prepublishOnly": "npm run verify",
    "smoke": "node smoke/smoke.cjs && node smoke/smoke.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@forge/kvs": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@forge/kvs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@forge/kvs": "^2.1.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
